# ./deployer.sh crée le fichier .env tout seul, en posant trois questions.
# À la main : copier ce fichier en .env et le compléter. Le fichier .env ne doit JAMAIS être commité.
DOMAINE=stage.ton-domaine.fr
# L'adresse à laquelle Let's Encrypt prévient si le certificat HTTPS va expirer
EMAIL_CERTIFICAT=toi@ton-domaine.fr
ANIMATEUR_MOT_DE_PASSE='change-moi par une longue phrase'
